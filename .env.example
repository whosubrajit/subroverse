# Public site URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:8443

# Neon pooled Postgres connection string
DATABASE_URL=postgresql://user:password@host/subroverse?sslmode=require

# Enable Neon Auth in the Neon console, then copy these values
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.example.com
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-endpoint.example.com

# Stable server-only secret used for opaque rate-limit keys.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated Neon Auth accounts that may enter the writer's room.
# Keep real addresses in .env.local and your deployment environment only.
ADMIN_EMAILS=admin-one@example.com,admin-two@example.com

# Created automatically when you connect a public Vercel Blob store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# Vercel Web Analytics: enable it in the project dashboard and deploy.
# These server-only values let the admin dashboard read traffic totals.
# Never expose VERCEL_TOKEN with a NEXT_PUBLIC_ prefix.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Required for a team-owned project; leave empty for a personal project.
VERCEL_TEAM_ID=
